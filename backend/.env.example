PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=10m
ADMIN_EMAIL=admin@acme.test
ADMIN_PASSWORD=admin123

# Test-friendly toggles
SIMULATE_NETWORK_DELAY_ENABLED=true
SIMULATE_NETWORK_DELAY_MS_MIN=200
SIMULATE_NETWORK_DELAY_MS_MAX=1200

RANDOM_FAILURES_ENABLED=false
RANDOM_FAILURE_RATE=0.2

# Session timeout simulation (forces 401 after N requests)
SESSION_TIMEOUT_ENABLED=false
SESSION_TIMEOUT_MAX_REQUESTS=15

# Seed sample users on startup if DB is empty
SEED_ON_START=true

