PORT=4001
CLIENT_ORIGIN=http://localhost:5173

# Must match users API secret so the same token works here
JWT_SECRET=dev_secret_change_me

# Test-friendly toggles
SIMULATE_NETWORK_DELAY_ENABLED=true
SIMULATE_NETWORK_DELAY_MS_MIN=200
SIMULATE_NETWORK_DELAY_MS_MAX=1200

RANDOM_FAILURES_ENABLED=false
RANDOM_FAILURE_RATE=0.2

# Seed sample products on startup if DB is empty
SEED_ON_START=true

